# ============================================================================
# erza-automation — QA suite (API load + Playwright E2E + auto-login)
#
# DEMO MODE (portfolio / CI with no real credentials):
#   Set ERZA_EMAIL=test@example.com + ERZA_PASSWORD=placeholder-password
#   -> all auth-dependent tests (E2E, k6-smoke) skip gracefully; CI stays green.
#
# REAL MODE:
#   Put working dev-host credentials below. Auth flow:
#   /en/signin -> login (or auto-signup) -> saves .auth/user.json -> E2E reuse.
# ============================================================================

# ---- Playwright E2E (public dev host) ----
ERZA_BASE_URL="https://dev.erza.ai"
ERZA_EMAIL="test@example.com"
ERZA_PASSWORD="placeholder-password"
ERZA_NAME="QA User"

# ---- k6 smoke (Better Auth on public dev host) ----
# Uses the same ERZA_EMAIL / ERZA_PASSWORD (public host, not the API gateway)

# ---- Load / streaming test (SSE via X-API-Key) ----
STREAM_URL="https://ai.dev.erza.ai/api/article/template/stream"
API_KEY=""

# ---- Legacy k6 modules (api/core/*, test/*) target a local API gateway ----
# These mirror the original `performance/` project and expect a private API host.
AUTH_BASE_URL="http://localhost:80"
BASE_URL="http://localhost:8080"
ROLE_SECRET_KEY=""
